<?php

namespace App\Modules\Core\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Modules\Core\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Hash;

class LoginController extends Controller
{
    /**
     * Handle Login Request
     *
     * Login accepts:
     * - Email
     * - Username (resolved to username@school.local)
     * - Phone
     *
     * Parent and student accounts may intentionally share the same
     * email/phone, especially during initial account setup, so the
     * password is used together with the identifier to narrow down
     * to the correct account(s).
     *
     * If more than one account matches BOTH the identifier and the
     * password, the frontend receives ACCOUNT_SELECTION_REQUIRED
     * and must resubmit with user_id set to the chosen account.
     */
    public function login(Request $request)
    {
        $request->validate([
            'email'    => 'required|string',
            'password' => 'required|string',
            'user_id'  => 'nullable|integer',
        ]);

        $input    = trim($request->input('email'));
        $password = $request->input('password');

        // If it's not a real email, also try it as a username under
        // the internal school domain.
        $searchEmail = filter_var($input, FILTER_VALIDATE_EMAIL)
            ? $input
            : $input . '@school.local';

        // 1. Find every account matching this identifier. We never
        // pick the first match here — a parent and several children
        // can legitimately share the same email/phone.
        $matchingUsers = User::where(function ($query) use ($input, $searchEmail) {
            $query->where('email', $input)
                  ->orWhere('email', $searchEmail)
                  ->orWhere('phone', $input);
        })->get();

        if ($matchingUsers->isEmpty()) {
            return response()->json(['error' => 'Invalid credentials'], 401);
        }

        // 2. Narrow to accounts whose password also matches.
        $validUsers = $matchingUsers
            ->filter(fn ($user) => Hash::check($password, $user->password))
            ->values();

        if ($validUsers->isEmpty()) {
            return response()->json(['error' => 'Invalid credentials'], 401);
        }

        // 3. Resolve the target account.
        if ($request->filled('user_id')) {
            // Frontend account picker was used. Only trust a user_id
            // that is ALSO in the password-valid set — this re-proves
            // both identifier ownership and password ownership.
            $targetUser = $validUsers->firstWhere('id', (int) $request->input('user_id'));

            if (!$targetUser) {
                return response()->json([
                    'error' => 'Selected account does not match the supplied credentials.',
                ], 401);
            }
        } elseif ($validUsers->count() > 1) {
            // Multiple valid accounts and no selection made yet.
            // Force the frontend to show the picker. Do NOT log in.
            return response()->json([
                'status'  => 'ACCOUNT_SELECTION_REQUIRED',
                'message' => 'Multiple accounts match these credentials. Please select the account you want to access.',
                'accounts' => $validUsers->map(fn ($user) => [
                    'id'    => $user->id,
                    'name'  => $user->name,
                    'email' => $user->email,
                    'role'  => $user->role,
                ])->values(),
            ], 200);
        } else {
            // Exactly one valid account — typical once passwords diverge.
            $targetUser = $validUsers->first();
        }

        return $this->authenticateUser($targetUser);
    }

    /**
     * Authenticate the fully verified user and issue a JWT.
     */
    protected function authenticateUser(User $user)
    {
        $token = Auth::guard('api')->login($user);

        return $this->respondWithToken($token);
    }

    /**
     * Build the login response payload.
     */
    protected function respondWithToken($token)
    {
        $user = auth('api')->user();

        $userPayload = [
            'id'                    => $user->id,
            'name'                  => $user->name,
            'email'                 => $user->email,
            'role'                  => $user->role,
            'phone'                 => $user->phone,
            'must_change_password'  => (bool) $user->must_change_password,
            'school'                => $user->school ? [
                'id'          => $user->school->id,
                'name'        => $user->school->name,
                'is_unlocked' => (bool) $user->school->is_unlocked,
            ] : null,
            'permissions'           => $this->getUserPermissions($user),
        ];

        return response()->json([
            'access_token'      => $token,
            'token_type'        => 'bearer',
            'expires_in'        => auth('api')->factory()->getTTL() * 60,
            'user'              => $userPayload,
            'default_dashboard' => $this->getDashboardRoute($user),
        ]);
    }

    /**
     * Determine the dashboard route for the authenticated user's role.
     */
    protected function getDashboardRoute($user): string
    {
        if ($user->isSuperAdmin()) {
            return '/super-admin/dashboard';
        }

        if ($user->role === 'employee' && $user->employee_type === 'teaching') {
            return '/employee/dashboard';
        }

        if ($user->role === 'employee' && $user->employee_type === 'account') {
            return '/account/dashboard';
        }

        if ($user->role === 'student') {
            return '/student/dashboard';
        }

        if ($user->role === 'parent') {
            return '/parent/dashboard';
        }

        if ($user->school_id) {
            return '/school/dashboard';
        }

        return '/dashboard';
    }

    protected function getUserPermissions($user): array
    {
        if (method_exists($user, 'getPermissions')) {
            return $user->getPermissions();
        }

        return [];
    }
}
